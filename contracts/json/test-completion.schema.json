{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test completion response data",
  "description": "검사 완료 후 아동 App에 제공하는 완료 화면 정보입니다. 정답, 정확도와 분석 결과는 포함하지 않습니다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "completionType": {
      "const": "TEST_COMPLETED"
    },
    "testId": {
      "type": "integer",
      "format": "int64"
    },
    "status": {
      "const": "COMPLETED"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "messageKey": {
      "const": "TEST_COMPLETE_GREAT_JOB"
    },
    "nextAction": {
      "const": "SHOW_COMPLETION"
    }
  },
  "required": [
    "completionType",
    "testId",
    "status",
    "completedAt",
    "messageKey",
    "nextAction"
  ]
}
