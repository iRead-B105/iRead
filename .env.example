# Copy this file to .env for the local Docker demo. Never commit real secrets.
COMPOSE_PROJECT_NAME=iread-demo
IREAD_CONTAINER_PREFIX=iread
IREAD_VOLUME_PREFIX=iread-demo
IREAD_NETWORK_NAME=iread-network
TZ=Asia/Seoul

MYSQL_DATABASE=iread_demo
MYSQL_USER=iread
MYSQL_PASSWORD=iread-demo
MYSQL_ROOT_PASSWORD=iread-root-demo
MYSQL_PORT=3307
REDIS_PORT=6379

BACKEND_PORT=8080
AI_PORT=8081
FRONTEND_WEB_PORT=5173
FRONTEND_APP_PORT=5174
SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

SPRING_PROFILES_ACTIVE=demo
IREAD_QA_DEMO_DATASET_ENABLED=true
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
AI_API_KEY=iread-local-ai-key
AI_READ_TIMEOUT=210s
TYPECAST_API_KEY=

AI_MOCK_GENERATE=true
AI_MOCK_STORY=false
AI_MOCK_IMAGE=false
AI_MOCK_EVALUATE=true
AI_MOCK_SPEECH=true
AI_MOCK_PRONUNCIATION=false
AI_MOCK_TRANSCRIBE=true
AI_MOCK_TTS=true

VITE_GAZE_WS_URL=ws://host.docker.internal:8765/gaze
VITE_GAZE_MODE_URL=http://host.docker.internal:8765/api/mode
